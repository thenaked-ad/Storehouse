---
layout: base.njk
permalink: about.html
key: about
---
  <div class="page--single">
  <section class="shell band">
    <div class="single-grid single-grid--about">

      <div>
        <span class="ledger">04</span>
        <h1 class="single-title">About</h1>
{%- for para in about.text | paragraphs %}
        <p style="margin-top:1rem;max-width:30em">
          {{ para | typeset | safe }}
        </p>
{%- endfor %}

        <p style="margin-top:1.5rem">
          <a class="action" href="{{ about.email_subject | mailto(site.email) | safe }}">{{ about.button | typeset | safe }} <span class="arrow" aria-hidden="true"></span></a>
        </p>
      </div>

      <div class="portrait">
        <figure class="portrait__figure">
          <div class="plate plate--tall">
            {%- set ph = photos[about.photo] %}{% if ph %}
            <img src="{{ ph.url }}" srcset="{{ ph.srcset }}" sizes="(min-width: 62rem) 30rem, 100vw"
                 width="{{ ph.width }}" height="{{ ph.height }}" loading="lazy" decoding="async"
                 alt="{{ about.photo_alt | attr | safe }}">
{%- endif %}
          </div>
{%- if about.photo_caption %}
          <figcaption class="photo-caption">{{ about.photo_caption | typeset | safe }}</figcaption>
{%- endif %}
        </figure>
      </div>

    </div>
  </section>
  </div>

