  <!-- ================================================ the expanding index -->
  <!-- The sections run the full width, text only. Each is an ordinary
       <details>, so with the script absent every one still opens and closes;
       the shared name keeps one open at a time. A link to /page#section opens
       that section on arrival. Below them, in the blue, the page's photographs
       as a strip across the full width. The copy and photographs come from
       content/{{ key }}.yml. -->
  <section class="services-page">
    <div class="shell services-page__main">
      <div class="services-page__head">
        <span class="ledger">{{ ledger }}</span>
        <h1>{{ heading | safe }}</h1>
      </div>

      <div class="services">
{%- for s in data.segments %}
        <details class="service" name="{{ group }}" id="{{ s.title | slugify }}">
          <summary>
            <span class="service__index">{{ ledger }}.{{ loop.index }}</span>
            <span class="service__title">{{ s.title | typeset | safe }}</span>
            <span class="service__sign" aria-hidden="true"></span>
          </summary>
          <div class="service__body">
            <div class="prose">
{%- for block in s.text | blocks %}
              {{ block | safe }}
{%- endfor %}
            </div>
{%- if s.button %}
            <a class="btn btn--self" href="{{ s.email_subject | mailto(site.email) | safe }}">{{ s.button | typeset | safe }} <span class="arrow" aria-hidden="true"></span></a>
{%- endif %}
          </div>
        </details>
{%- endfor %}
      </div>
    </div>
{%- set shots = [] %}
{%- for p in data.slideshow or [] %}{% if photos[p.image] %}{% set shots = (shots.push({ img: photos[p.image], alt: p.alt, caption: p.caption }), shots) %}{% endif %}{% endfor %}
{%- if shots.length %}

    <!-- The page's photographs: a strip running the full width of the window,
         from the line of the text above off the right-hand edge. Each is shown
         whole at one height, with its caption under it. It scrolls sideways on
         its own (trackpad, touch, a drag with the mouse, or the arrows), so
         with no script it is still a working strip. -->
    <div class="strip" data-strip>
      <div class="strip__track" tabindex="0" role="region" aria-label="Photographs">
{%- for shot in shots %}
        <figure class="strip__item">
          <img src="{{ shot.img.url }}" srcset="{{ shot.img.srcset }}" sizes="(min-width: 40rem) 60vw, 90vw"
               width="{{ shot.img.width }}" height="{{ shot.img.height }}" style="--ar: {{ shot.img.width / shot.img.height }}"
               loading="{{ 'eager' if loop.index <= 2 else 'lazy' }}" decoding="async" alt="{{ shot.alt | attr | safe }}" draggable="false">
{%- if shot.caption %}
          <figcaption>{{ shot.caption | typeset | safe }}</figcaption>
{%- endif %}
        </figure>
{%- endfor %}
      </div>
      <div class="shell strip__bar">
        <span class="strip__controls">
          <button class="carousel__step carousel__step--prev" type="button" aria-label="Previous photographs"><span class="arrow" aria-hidden="true"></span></button>
          <button class="carousel__step carousel__step--next" type="button" aria-label="Next photographs"><span class="arrow" aria-hidden="true"></span></button>
        </span>
      </div>
    </div>
{%- endif %}
  </section>

{% set panel = data.panel %}{% include "panel.njk" %}
